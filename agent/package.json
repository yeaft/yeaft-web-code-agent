{
  "name": "@yeaft/webchat-agent",
  "version": "1.0.0",
  "description": "Remote worker agent for Yeaft Web Code Agent — connects the native Yeaft engine, CLI providers, and workbench tools",
  "main": "index.js",
  "type": "module",
  "bin": {
    "yeaft-agent": "cli.js",
    "yeaft-agent-container": "container-cli.js",
    "yeaft": "yeaft/cli.js",
    "yeaft-repo": "bin/yeaft-repo.js",
    "yeaft-stats": "bin/yeaft-stats.js"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "prepack": "node ../web/build.js && node scripts/prepare-local-runtime.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "claude",
    "agent",
    "remote",
    "websocket",
    "cli",
    "yeaft"
  ],
  "homepage": "https://github.com/yeaft/claude-web-chat",
  "repository": {
    "type": "git",
    "url": "https://github.com/yeaft/claude-web-chat.git",
    "directory": "agent"
  },
  "bugs": {
    "url": "https://github.com/yeaft/claude-web-chat/issues"
  },
  "files": [
    "**/*.js",
    "Dockerfile",
    "docker-entrypoint.sh",
    "yeaft/templates/**/*.md",
    "yeaft/dream/prompts/**/*.md",
    "skills/**/*.md",
    "browser-runtime/extension/**/*",
    "browser-runtime/*.ps1",
    "local-runtime/**/*"
  ],
  "license": "MIT",
  "author": "Yeaft",
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": [
      "*.js",
      "sdk/*.js"
    ],
    "ignore": [
      "node_modules",
      "package-lock.json",
      ".claude-agent.json"
    ],
    "ext": "js"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@puppeteer/browsers": "2.13.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "puppeteer-core": "24.41.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "uuid": "^11.1.1",
    "ws": "^8.21.0"
  }
}
